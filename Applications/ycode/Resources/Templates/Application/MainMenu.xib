<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="21507" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
  <dependencies>
    <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="21507"/>
  </dependencies>
  <objects>
    <customObject id="-2" userLabel="File's Owner" customClass="NSApplication">
      <connections>
        <outlet property="delegate" destination="controller" id="delegate-connection"/>
        <outlet property="mainMenu" destination="main-menu" id="menu-connection"/>
      </connections>
    </customObject>
    <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
    <customObject id="-3" userLabel="Application" customClass="NSObject"/>
    <customObject id="controller" customClass="AppController">
      <connections>
        <outlet property="window" destination="main-window" id="window-connection"/>
      </connections>
    </customObject>
    <menu title="Main Menu" systemMenu="main" id="main-menu">
      <items>
        <menuItem title="Application" id="application-item">
          <menu key="submenu" title="Application" systemMenu="apple" id="application-menu">
            <items>
              <menuItem title="About" id="about-item">
                <connections><action selector="orderFrontStandardAboutPanel:" target="-2" id="about-action"/></connections>
              </menuItem>
              <menuItem isSeparatorItem="YES" id="separator"/>
              <menuItem title="Quit" keyEquivalent="q" id="quit-item">
                <connections><action selector="terminate:" target="-2" id="quit-action"/></connections>
              </menuItem>
            </items>
          </menu>
        </menuItem>
      </items>
    </menu>
    <window title="Main Window" visibleAtLaunch="NO" releasedWhenClosed="NO" id="main-window">
      <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
      <rect key="contentRect" x="100" y="100" width="640" height="480"/>
      <view key="contentView" id="content-view">
        <rect key="frame" x="0.0" y="0.0" width="640" height="480"/>
        <autoresizingMask key="autoresizingMask"/>
      </view>
    </window>
  </objects>
</document>
